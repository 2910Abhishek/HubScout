# HubScout: your external API keys. Copy to .env (scripts/init_env.sh does it) and fill in.
# Only secrets live here; every other setting has a default in app/config.py.
# Local infrastructure passwords are generated separately into .env.infra.

# Required. LLM access for HubScout's own agents: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Required. Benchmarks/pricing for the API path (free tier, attribution required): https://artificialanalysis.ai/
ARTIFICIAL_ANALYSIS_API_KEY=
# Required. Lets LangGraph Studio connect to `langgraph dev`: https://smith.langchain.com/settings
LANGSMITH_API_KEY=
# Recommended. Higher Hugging Face rate limits and gated repos (read scope): https://huggingface.co/settings/tokens
HF_TOKEN=
# Optional. Higher GitHub API limits (fine-grained, public read-only).
GITHUB_TOKEN=
# Optional. Higher Semantic Scholar limits: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
