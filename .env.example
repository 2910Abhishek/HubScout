# =============================================================================
# HubScout environment variables
# -----------------------------------------------------------------------------
# Every variable used anywhere in the project is listed here with NO values.
# Empty values fall back to the default noted in the comment (see app/config.py).
# Create your local file with:  scripts/init_env.sh   (generates local infra
# secrets for you; you only paste your external API keys). Never commit .env.
# =============================================================================


# ----------------------------------------------------------------------------
# LLM: OpenRouter (primary provider for HubScout's own agents)
# ----------------------------------------------------------------------------
# Your OpenRouter key (https://openrouter.ai/keys). Required for live LLM calls.
OPENROUTER_API_KEY=
# Default: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
# Public model catalogue. Default: https://openrouter.ai/api/v1/models
OPENROUTER_MODELS_URL=
# Free-model rate limits. Default 20/min; 50/day without purchased credits
# (set 1000 once you have ever bought >= $10 of credits).
OPENROUTER_RPM=
OPENROUTER_RPD=
# Request timeout in seconds (default 60) and retries (default 1: retries burn quota).
OPENROUTER_TIMEOUT_S=
OPENROUTER_MAX_RETRIES=
# Optional attribution shown on openrouter.ai (HTTP-Referer / X-Title). Default title: HubScout
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# ----------------------------------------------------------------------------
# LLM: model per tier (REQUIRED). Pick from the live catalogue: must support
# `tools` (and ideally `structured_outputs`). Verified candidates on 2026-09-27:
#   strong: nvidia/nemotron-3-super-120b-a12b:free
#   cheap:  qwen/qwen3.8-27b:free
#   router: openrouter/free   (lets OpenRouter pick any free model)
# The judge is pinned and never falls back.
# ----------------------------------------------------------------------------
LLM_MODEL_STRONG=
LLM_MODEL_CHEAP=
LLM_MODEL_JUDGE=
# Default 0.0
LLM_TEMPERATURE=
# Max simultaneous LLM calls. Default 3
LLM_MAX_CONCURRENCY=

# ----------------------------------------------------------------------------
# LLM: local Ollama fallback (OpenAI-compatible /v1 endpoint)
# ----------------------------------------------------------------------------
# Default: http://localhost:11434
OLLAMA_BASE_URL=
# REQUIRED. A small tool-calling model pulled locally (chosen in Phase 1).
OLLAMA_MODEL=
# Ollama ignores the key; default "ollama".
OLLAMA_API_KEY=
# Default 180 (CPU inference is slow)
OLLAMA_TIMEOUT_S=

# ----------------------------------------------------------------------------
# Data sources
# ----------------------------------------------------------------------------
# Hugging Face token (read scope) for higher rate limits and gated repos.
HF_TOKEN=
# Default: https://huggingface.co/mcp
HF_MCP_URL=
# Artificial Analysis free API key (attribution required: https://artificialanalysis.ai/).
ARTIFICIAL_ANALYSIS_API_KEY=
# Default: https://artificialanalysis.ai/api/v2
ARTIFICIAL_ANALYSIS_BASE_URL=
# Optional (higher limits). Default base: https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=
# Optional GitHub token (read-only, public repos). Default API: https://api.github.com
GITHUB_TOKEN=
GITHUB_API_URL=
# Default: https://pypi.org/pypi
PYPI_BASE_URL=
# Default: https://export.arxiv.org/api/query
ARXIV_API_URL=
# Default 30
HTTP_TIMEOUT_S=

# ----------------------------------------------------------------------------
# Web search (SearXNG, self-hosted in Compose)
# ----------------------------------------------------------------------------
# Default: http://localhost:8888
SEARXNG_URL=
# Compose: SearXNG server secret (random hex; generated by scripts/init_env.sh).
SEARXNG_SECRET=

# ----------------------------------------------------------------------------
# Infrastructure: Postgres + pgvector, Redis
# ----------------------------------------------------------------------------
# Compose: credentials for the HubScout Postgres container.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# REQUIRED. App connection string, e.g. postgresql://USER:PASSWORD@localhost:5433/DB  # pragma: allowlist secret
# (host port 5433 because 5432 is taken on this machine).
DATABASE_URL=
# Default: redis://localhost:6379/0
REDIS_URL=
# Cache TTLs in seconds. Defaults: registry 21600, pricing 86400, search 3600
REGISTRY_CACHE_TTL_S=
PRICING_CACHE_TTL_S=
SEARCH_CACHE_TTL_S=

# ----------------------------------------------------------------------------
# Sandbox & verification (Phase 4)
# ----------------------------------------------------------------------------
# Defaults: image hubscout-sandbox:latest, timeout 600 s, 2 CPUs, 4096 MB RAM,
# 10240 MB disk, seed 42, sample size 100, API spend cap $1.00 per run.
SANDBOX_IMAGE=
SANDBOX_TIMEOUT_S=
SANDBOX_CPUS=
SANDBOX_MEMORY_MB=
SANDBOX_DISK_MB=
SANDBOX_SEED=
SANDBOX_SAMPLE_SIZE=
SANDBOX_API_VERIFY_MAX_COST_USD=

# ----------------------------------------------------------------------------
# Verifier agent over A2A (Phase 4)
# ----------------------------------------------------------------------------
# Default: http://localhost:9000
VERIFIER_A2A_URL=

# ----------------------------------------------------------------------------
# Observability: Langfuse (app side), LangSmith (Studio), logging
# ----------------------------------------------------------------------------
# Default: http://localhost:3000
LANGFUSE_HOST=
# Project keys; with the Compose setup these equal LANGFUSE_INIT_PROJECT_*_KEY below.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Needed for LangGraph Studio (smith.langchain.com) to connect to `langgraph dev`.
LANGSMITH_API_KEY=
# DEBUG | INFO | WARNING | ERROR. Default INFO
LOG_LEVEL=

# ----------------------------------------------------------------------------
# Langfuse server (Compose profile "observability"; all generated by init_env.sh)
# ----------------------------------------------------------------------------
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# 64 hex chars (openssl rand -hex 32)
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
# Headless init: creates the org, project, API keys and a login user on first start.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# ----------------------------------------------------------------------------
# Recommendation policy
# ----------------------------------------------------------------------------
# Comma-separated SPDX-style ids. Default: apache-2.0,mit,bsd-2-clause,bsd-3-clause
LICENCE_ALLOWLIST=
# ask | api | open_weight | compare. Default ask
DEFAULT_DEPLOYMENT_MODE=
# Default 2 (max 5)
MAX_CRITIC_LOOPS=
# Parallel scouts. Default 3
SCOUT_CONCURRENCY=

# ----------------------------------------------------------------------------
# FastAPI backend (Phase 6)
# ----------------------------------------------------------------------------
# Key clients must send to call the API.
API_AUTH_KEY=
# Defaults: 127.0.0.1:8000
API_HOST=
API_PORT=
