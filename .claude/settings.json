{
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(uv sync)",
      "Bash(uv add *)",
      "Bash(uv lock *)",
      "Bash(uv lock)",
      "Bash(docker compose *)",
      "Bash(docker *)",
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(git tag)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(scripts/check_prereqs.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(source .env)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)"
    ]
  },
  "enabledMcpjsonServers": ["context7", "huggingface"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_python.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
